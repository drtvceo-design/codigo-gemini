# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — COPIAR A .env (IGNORADO POR GIT)
# ==============================================================================

# Motor Multimodal Gemini 2.5 (Computer Use & Razonamiento)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Navegador y Escritorio Virtual X11
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
COMPUTER_USE_HEADLESS=true
COMPUTER_USE_VIEWPORT_WIDTH=1280
COMPUTER_USE_VIEWPORT_HEIGHT=800

# Integración Zapier (Catch Hook & MCP Guardrails)
ZAPIER_WEBHOOK_URL=
ZAPIER_DRY_RUN=true

# Integración opcional con Bot de Telegram (AVA / Serena)
TELEGRAM_BOT_TOKEN=
DR_TAPIA_TELEGRAM_ID=
